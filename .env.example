# Required: API key from https://console.groq.com
GROQ_API_KEY=

# Recommended for placement-cell use: a long random string. Keeps drive links
# and exported report signatures valid across server restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
VARS_SIGNING_KEY=

# Speech-to-text: auto (hosted, then local), groq (hosted only), local (GPU Whisper)
VARS_STT=auto

# Interviewer voice engines, tried in order (orpheus needs terms accepted in the Groq console)
VARS_TTS=orpheus,edge

# Run Java/C++ (and Python fallback) code on the server. Set to 0 on shared public hosting.
VARS_NATIVE_RUNNERS=1

# Model fallbacks, best first
# VARS_MODELS_SMART=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# VARS_MODELS_FAST=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b

# Server
# VARS_HOST=127.0.0.1
# VARS_PORT=5000
# VARS_MAX_UPLOAD_MB=12
